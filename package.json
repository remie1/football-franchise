{
  "name": "football-franchise",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/check-workspace-coverage.mjs && pnpm -r build",
    "test": "node scripts/check-workspace-coverage.mjs && pnpm -r test",
    "test:ci-rest": "node scripts/check-workspace-coverage.mjs && pnpm -r --filter '!@ff/calibration' test",
    "test:ci-calibration": "pnpm --filter @ff/calibration test",
    "typecheck": "node scripts/check-workspace-coverage.mjs && pnpm -r typecheck",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
