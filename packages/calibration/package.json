{
  "name": "@ff/calibration",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "ingest": "tsc -p tsconfig.json && node dist/ingest/cli.js",
    "known-truth": "vitest run test/knownTruth",
    "export-game": "vite-node src/export/main.ts --",
    "season": "vite-node src/season/main.ts --",
    "pocket": "vite-node src/pocket/main.ts --",
    "player-checks": "vite-node src/season/playerChecksMain.ts --",
    "injury-rates": "vite-node src/injuries/main.ts --",
    "cap-check": "vite-node src/season/capCheckMain.ts --",
    "snap-spots": "vite-node src/snapSpots/main.ts --"
  },
  "dependencies": {
    "@ff/attributes": "workspace:*",
    "@ff/contracts": "workspace:*",
    "@ff/engine": "workspace:*",
    "@ff/franchise": "workspace:*",
    "@ff/narrative": "workspace:*",
    "@ff/playbook": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite-node": "^2.1.0"
  }
}
